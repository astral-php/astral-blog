# ============================================================
# Astral Blog 1.0 — copiez en .env et adaptez
# ============================================================
APP_NAME="Astral Blog"
APP_VERSION=2.0.1
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_CHARSET=UTF-8
APP_BASE_URL=

DB_DRIVER=sqlite
DB_DATABASE=database/blog.sqlite

# AUTH_REGISTRATION=direct   # ou confirm (mailer)
AUTH_REGISTRATION=direct

MAIL_DRIVER=mail
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM=noreply@localhost
MAIL_FROM_NAME="Astral Blog"

ASTRAL_GITHUB_URL=https://github.com/astral-php
ASTRAL_WEBSITE_URL=https://github.com/astral-php
